DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

DB_USERNAME=root
# DB_DATABASE=vben-book-dev9
DB_DATABASE=vben-book-dev
DB_PASSWORD=example

DB_SYNC=false

LOG_ON=true

# 打印的日志级别
LOG_LEVEL=info
# 是否打印时间戳
TIMESTAMP=true

APP_PORT=3030

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_RECONNECT=true

# 开发环境特有配置
ENABLE_SWAGGER=true
