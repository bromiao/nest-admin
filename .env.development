DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

DB_USERNAME=root
# DB_DATABASE=vben-book-dev9
DB_DATABASE=vben-book-dev
DB_PASSWORD=example

DB_SYNC=false


# ORM配置 - 可选择 typeorm 或 prisma
ORM_TYPE=prisma

LOG_ON=true

# 打印的日志级别 - 改为debug以显示更多日志
LOG_LEVEL=debug
# 是否打印时间戳
TIMESTAMP=true

APP_PORT=3030

# Redis配置
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=example
REDIS_RECONNECT=true
REDIS_DB=1
REDIS_TTL=3600
REDIS_KEY_PREFIX=nest-admin-dev:

# 开发环境特有配置
ENABLE_SWAGGER=true
