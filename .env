DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

DB_USERNAME=root
DB_DATABASE=vben-book-dev
DB_PASSWORD=example

# Prisma DB_URL
DB_URL="mysql://root:example@127.0.0.1:3306/vben-book-dev"
SHADOW_DB_URL="mysql://root:example@127.0.0.1:3306/vben-book-dev-shadow"

# 数据库同步设置
DB_SYNC=false

LOG_ON=true

# 打印的日志级别
LOG_LEVEL=info
# 是否打印时间戳
TIMESTAMP=true

APP_PORT=3030

# Redis配置 - 默认禁用，由具体环境文件控制
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_KEY_PREFIX=nest-admin:
